// RUN: %{compiler} lex %s 2>&1 | FileCheck %s
let Point = struct { x: u32, y: u32, };
let Color = enum { red, green, blue, };
let Data = union { x: u32, };
let Drawable = trait { draw: *own Self -> void, };
let main = fn () -> void {
    let x = true;
    let mut y = false;
    let z = x and y;
    let w = x or y;
    if z { return; } else { return; }
    for i in 0..10 { continue; }
    while false { break; }
}

// CHECK:    2 > LET IDENTIFIER("Point") ASSIGN STRUCT LBRACE IDENTIFIER("x") COLON BASIC_TYPE("u32") COMMA IDENTIFIER("y") COLON BASIC_TYPE("u32") COMMA RBRACE SEMICOLON
// CHECK:    3 > LET IDENTIFIER("Color") ASSIGN ENUM LBRACE IDENTIFIER("red") COMMA IDENTIFIER("green") COMMA IDENTIFIER("blue") COMMA RBRACE SEMICOLON
// CHECK:    4 > LET IDENTIFIER("Data") ASSIGN UNION LBRACE IDENTIFIER("x") COLON BASIC_TYPE("u32") COMMA RBRACE SEMICOLON
// CHECK:    5 > LET IDENTIFIER("Drawable") ASSIGN TRAIT LBRACE IDENTIFIER("draw") COLON ASTERISK OWN SELF_TYPE ARROW BASIC_TYPE("void") COMMA RBRACE SEMICOLON
// CHECK:    6 > LET IDENTIFIER("main") ASSIGN FN LPAREN RPAREN ARROW BASIC_TYPE("void") LBRACE
// CHECK:    7 > LET IDENTIFIER("x") ASSIGN TRUE SEMICOLON
// CHECK:    8 > LET MUT IDENTIFIER("y") ASSIGN FALSE SEMICOLON
// CHECK:    9 > LET IDENTIFIER("z") ASSIGN IDENTIFIER("x") AND IDENTIFIER("y") SEMICOLON
// CHECK:   10 > LET IDENTIFIER("w") ASSIGN IDENTIFIER("x") OR IDENTIFIER("y") SEMICOLON
// CHECK:   11 > IF IDENTIFIER("z") LBRACE RETURN SEMICOLON RBRACE ELSE LBRACE RETURN SEMICOLON RBRACE
// CHECK:   12 > FOR IDENTIFIER("i") IN NUMBER("0") DOUBLE_DOT NUMBER("10") LBRACE CONTINUE SEMICOLON RBRACE
// CHECK:   13 > WHILE FALSE LBRACE BREAK SEMICOLON RBRACE
// CHECK:   14 > RBRACE
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
