// RUN: %{compiler} lex %s 2>&1 | FileCheck %s
let x: i32 = 42;


let y: bool = true;


let z = "hello";

// CHECK:    3 > LET IDENTIFIER("x") COLON BASIC_TYPE("i32") ASSIGN NUMBER("42") SEMICOLON
// CHECK:    6 > LET IDENTIFIER("y") COLON BASIC_TYPE("bool") ASSIGN TRUE SEMICOLON
// CHECK:    9 > LET IDENTIFIER("z") ASSIGN STRING_LITERAL("hello") SEMICOLON
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
