// SPDX-License-Identifier: MIT
// RUN: %{compiler} lex %s 2>&1 | FileCheck %s
+ ++;
- ->;
* **;
/ | & ^;

// CHECK:    3 > PLUS DOUBLE_PLUS SEMICOLON
// CHECK:    4 > MINUS ARROW SEMICOLON
// CHECK:    5 > ASTERISK DOUBLE_ASTERISK SEMICOLON
// CHECK:    6 > SLASH PIPE AMPERSAND CARET SEMICOLON
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
