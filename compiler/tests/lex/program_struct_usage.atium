// SPDX-License-Identifier: MIT
// RUN: %{compiler} lex %s 2>&1 | FileCheck %s
let Point = struct {
    x: i32,
    y: i32,
};

let Drawable = interface {
    draw: *Self -> void,
};

// CHECK:    3 > LET IDENTIFIER("Point") ASSIGN STRUCT LBRACE
// CHECK:    4 > IDENTIFIER("x") COLON BASIC_TYPE("i32") COMMA
// CHECK:    5 > IDENTIFIER("y") COLON BASIC_TYPE("i32") COMMA
// CHECK:    6 > RBRACE SEMICOLON
// CHECK:    8 > LET IDENTIFIER("Drawable") ASSIGN INTERFACE LBRACE
// CHECK:    9 > IDENTIFIER("draw") COLON ASTERISK SELF_TYPE ARROW BASIC_TYPE("void") COMMA
// CHECK:    10 > RBRACE SEMICOLON
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
