// SPDX-License-Identifier: MIT
// RUN: %{compiler} lex %s 2>&1 | FileCheck %s
= ==;
! !=;
> >= >>;
< <= <<;

// CHECK:    2 > ASSIGN EQUAL SEMICOLON
// CHECK:    3 > EXCLAMATION NOT_EQUAL SEMICOLON
// CHECK:    4 > GREATER GREATER_EQUAL DOUBLE_GREATER SEMICOLON
// CHECK:    5 > LESS LESS_EQUAL DOUBLE_LESS SEMICOLON
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
