// SPDX-License-Identifier: MIT
// RUN: %{compiler} parse %s 2>&1 | FileCheck %s

let sum = a + b;
let product = x * y;
let complex = a + b * c - d / e;

// CHECK: %0 : let sum = %1
// CHECK: %1 : a + b
// CHECK: %2 : let product = %3
// CHECK: %3 : x * y
// CHECK: %4 : let complex = %5
// CHECK: %5 : %6 - %7
// CHECK: %6 : a + %8
// CHECK: %8 : b * c
// CHECK: %7 : d / e
// CHECK-NOT: ERROR
// CHECK-NOT: WARNING
